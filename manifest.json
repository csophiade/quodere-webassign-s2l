{
  "manifest_version": 3,
  "name": "WebAssign Voice Answer",
  "version": "0.4",
  "description": "Click an answer box, press comma, say the answer.",
  "permissions": ["storage"],
  "icons": { "48": "icon48.png", "128": "icon128.png" },
  "action": { "default_popup": "popup.html", "default_icon": "icon48.png", "default_title": "WebAssign Voice Answer" },
  "content_scripts": [
    {
      "matches": ["*://*.webassign.net/*", "*://*.webassign.com/*", "*://*.cengage.com/*"],
      "js": ["main.js"],
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.webassign.net/*", "*://*.webassign.com/*", "*://*.cengage.com/*"],
      "js": ["parse.js", "content.js"],
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ]
}
